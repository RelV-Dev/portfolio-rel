{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/clear_cache.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/info.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/chat.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/guestbook.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/three-r128/(three.min.js|OrbitControls.js|LICENSE)",
      "dest": "/assets/three-r128/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/github-scene.js",
      "dest": "/github-scene.js"
    },
    {
      "src": "/assets/icons/(icons.css|LICENSE.txt)",
      "dest": "/assets/icons/$1"
    },
    {
      "src": "/portfolio-ui.js",
      "dest": "/portfolio-ui.js"
    },
    {
      "src": "/api/guestbook.php",
      "dest": "/api/guestbook.php"
    },
    {
      "src": "/api/chat.php",
      "dest": "/api/chat.php"
    },
    {
      "src": "/portfolio.css",
      "dest": "/portfolio.css"
    },
    {
      "src": "/clear_cache.php",
      "dest": "/api/clear_cache.php"
    },
    {
      "src": "/info.php",
      "dest": "/api/info.php"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/dashboard.html",
      "dest": "/dashboard.html"
    },
    {
      "src": "/dashboard.css",
      "dest": "/dashboard.css"
    },
    {
      "src": "/dashboard.js",
      "dest": "/dashboard.js"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
